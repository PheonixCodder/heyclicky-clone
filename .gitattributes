# ==============================================================================
# Kursor — Git Attributes & Line-Ending Normalization (.gitattributes)
# ==============================================================================

* text=auto

# Windows PowerShell, Batch, VBScript & MSBuild / .NET Solution Files (CRLF)
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
*.vbs text eol=crlf
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf

# Cross-Platform TypeScript, JavaScript, JSON, Markdown & SQL Files (LF)
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.md text eol=lf
*.sql text eol=lf

# Binary Assets, Executables, Native Libraries & Archives
*.dll binary
*.exe binary
*.pdb binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.mp3 binary
*.ogg binary
*.woff binary
*.woff2 binary
*.ttf binary
*.zip binary
*.nupkg binary
*.db binary
*.bin binary
