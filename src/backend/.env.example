# ==============================================================================
# KURSOR BACKEND CONFIGURATION (.env.example)
# ==============================================================================

# 1. Server & Local SQLite Database
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=./data/kursor.db
KURSOR_DEV_BYPASS_AUTH=true

# 2. Primary Brain & Search Router (OpenRouter - Required for Phase 2+ Brain)
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=anthropic/claude-sonnet-4.6
OPENROUTER_FAST_MODEL=google/gemini-3.1-flash-lite-preview
OPENROUTER_SEARCH_MODEL=perplexity/sonar-pro

# 3. Direct Provider Keys (Used for Voice, Realtime, or Direct Brain Routing)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 4. Voice & Dictation Keys (Ears, Mouth, Dictation Cleanup)
DEEPGRAM_API_KEY=
GROQ_API_KEY=

# 5. Provider Selection Policies
# Ears: "deepgram" | "gemini"
EARS_PRIMARY_PROVIDER=deepgram
# Mouth: "openai-realtime" | "gemini-tts" | "edge-tts"
MOUTH_PRIMARY_PROVIDER=openai-realtime
# Dictation Cleanup: "groq" | "openrouter" | "gemini"
DICTATION_CLEANUP_PROVIDER=groq
# Web Search: "duckduckgo" | "openrouter" | "tavily" | "brave" | "serper"
WEB_SEARCH_PROVIDER=duckduckgo

# 6. Optional Dedicated Search & Composio Keys
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPER_API_KEY=
COMPOSIO_API_KEY=
